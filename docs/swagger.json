                                    "$ref": "#/components/schemas/handlers.ErrorResponse"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "summary": "Get the result of a certain task",
                "tags": [
                    "task"
                ]
            }
