                    "username": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "handlers.loginResponse": {
                "properties": {
                    "token": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "handlers.registerResponse": {
                "properties": {
                    "message": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "handlers.taskCreateRequest": {
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "translator": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "handlers.taskCreateResponse": {
                "properties": {
                    "task_id": {
                        "type": "string"
